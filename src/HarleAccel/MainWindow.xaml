<Window x:Class="HarleAccel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HarleAccel" Icon="Assets/logo.ico" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Silver}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Barra lateral ========== -->
        <Border Background="#99050A18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,16">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,26">
                    <Grid Width="44" Height="44">
                        <Border x:Name="LogoFallback" Background="{StaticResource AccentGradient}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <TextBlock Text="H" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="{DynamicResource DisplayFont}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="LogoBorder" ClipToBounds="True" Visibility="Collapsed" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Effect="{StaticResource GlowSoft}">
                            <Border.Background>
                                <ImageBrush x:Name="LogoBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HARLEACCEL" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Silver}"
                                   FontFamily="{DynamicResource DisplayFont}" Effect="{StaticResource Glow}"/>
                        <TextBlock Text="BY HARLE" FontSize="10" Foreground="{StaticResource Muted}" FontFamily="{DynamicResource DataFont}" Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status do driver -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" Padding="12,10"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="DriverDot" Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" Effect="{StaticResource GlowSoft}"/>
                        <TextBlock x:Name="DriverShort" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Muted}" FontFamily="{DynamicResource DataFont}"
                                   Text="Driver" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <RadioButton DockPanel.Dock="Bottom" x:Name="NavCredits" Style="{StaticResource NavItem}"
                             Content="Créditos" Checked="Nav_Checked" Tag=""/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="Início" Checked="Nav_Checked" Tag=""/>
                        <RadioButton x:Name="NavChat" Style="{StaticResource NavItem}" Content="Harle IA" Checked="Nav_Checked" Tag="NOVO"/>
                        <RadioButton x:Name="NavWizard" Style="{StaticResource NavItem}" Content="Assistente" Checked="Nav_Checked" Tag=""/>

                        <TextBlock Text="CONFIGURAR" Style="{StaticResource Label}" Margin="14,14,0,4" FontSize="10"/>
                        <RadioButton x:Name="NavSens" Style="{StaticResource NavItem}" Content="Sensibilidade" Checked="Nav_Checked" Tag=""/>
                        <RadioButton x:Name="NavCurve" Style="{StaticResource NavItem}" Content="Curva" Checked="Nav_Checked" Tag=""/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="Histórico" Checked="Nav_Checked" Tag=""/>

                        <TextBlock Text="DESCOBRIR E TREINAR" Style="{StaticResource Label}" Margin="14,14,0,4" FontSize="10"/>
                        <RadioButton x:Name="NavProfile" Style="{StaticResource NavItem}" Content="Teste de Perfil" Checked="Nav_Checked" Tag=""/>
                        <RadioButton x:Name="NavAim" Style="{StaticResource NavItem}" Content="Aim Test e A/B" Checked="Nav_Checked" Tag=""/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Content="Diagnóstico do mouse" Checked="Nav_Checked" Tag=""/>
                        <RadioButton x:Name="NavTraining" Style="{StaticResource NavItem}" Content="Treino" Checked="Nav_Checked" Tag=""/>

                        <TextBlock Text="APP" Style="{StaticResource Label}" Margin="14,14,0,4" FontSize="10"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Configurações" Checked="Nav_Checked" Tag=""/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== Conteúdo ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TitleBtn}" Content="—" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource TitleBtn}" Content="▢" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource TitleBtn}" Content="✕" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="32,0,32,24">
                <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Depois" Style="{StaticResource Ghost}" Click="UpdateLater_Click"/>
                        <Button DockPanel.Dock="Right" Content="Baixar" Style="{StaticResource Primary}" Click="UpdateGet_Click" Margin="0,0,6,0"/>
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="Host"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
