<UserControl x:Class="HarleAccel.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HarleAccel.Controls">
    <DockPanel>
        <!-- Cabeçalho + passos -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Assistente" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16" Text="Cinco passos e você sai daqui com o driver pronto, o Windows conferido e a primeira curva aplicada."/>
            <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Navegação -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="BackBtn" Content="Voltar" Click="Back_Click" DockPanel.Dock="Left"/>
            <Button x:Name="NextBtn" Content="Próximo" Style="{StaticResource Primary}" Click="Next_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="22,10"/>
            <TextBlock x:Name="NavStatus" FontSize="12" VerticalAlignment="Center" Margin="16,0" TextWrapping="Wrap"/>
        </DockPanel>

        <Border Style="{StaticResource CardBorder}" Padding="24">
            <Grid>
                <!-- 1. Boas-vindas -->
                <StackPanel x:Name="Step1">
                    <TextBlock Text="Bem-vindo ao HarleAccel" Style="{StaticResource H2}" FontSize="20"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="14" LineHeight="22" Foreground="{StaticResource Silver}">
                        O HarleAccel deixa a sua sensibilidade mudar de acordo com a velocidade da mão:
                        <LineBreak/>• movimento lento (microajuste) = a sua sens normal do jogo
                        <LineBreak/>• movimento rápido (flick) = sens um pouco maior, para virar sem precisar de tanto espaço no mousepad
                        <LineBreak/><LineBreak/>
                        Ele usa o driver <Run FontWeight="SemiBold" Foreground="{StaticResource AccentHi}">oficial e assinado do Raw Accel</Run>, o mesmo que funciona com Vanguard e FACEIT. O app baixa o driver direto do GitHub oficial e confere se o arquivo é o original antes de instalar.
                        <LineBreak/><LineBreak/>
                        Você pode desligar tudo a qualquer momento e voltar ao normal com um clique.
                    </TextBlock>
                </StackPanel>

                <!-- 2. Driver -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="Driver do Raw Accel" Style="{StaticResource H2}" FontSize="20"/>
                    <TextBlock x:Name="DrvStatus" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="1" Width="26" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentHi}" VerticalAlignment="Center"/>
                        <Button x:Name="DownloadBtn" Content="Baixar e verificar o Raw Accel oficial" Click="Download_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="DlProgress" Height="4" Margin="26,0,0,10" Maximum="1" Visibility="Collapsed"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="2" Width="26" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentHi}" VerticalAlignment="Center"/>
                        <Button x:Name="InstallBtn" Content="Instalar o driver (pede administrador)" Click="Install_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="3" Width="26" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentHi}" VerticalAlignment="Center"/>
                        <TextBlock Text="Reinicie o PC quando terminar (o driver só carrega depois disso)." Foreground="{StaticResource Silver}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Já tenho o Raw Accel instalado (escolher a pasta dele)" Style="{StaticResource Ghost}"
                            HorizontalAlignment="Left" Click="PickFolder_Click"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,10,0,0"
                               Text="Pode seguir o assistente agora e reiniciar no final. A curva fica salva e você aplica depois."/>
                </StackPanel>

                <!-- 3. Checagem -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="Checagem do setup" Style="{StaticResource H2}" FontSize="20"/>

                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <DockPanel>
                            <Button x:Name="EppFixBtn" DockPanel.Dock="Right" Content="Desligar" Click="EppFix_Click" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="“Aumentar precisão do ponteiro” do Windows" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="EppStatus" Style="{StaticResource Sub}" Margin="0,4,12,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Angle snapping no software do mouse" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,8"
                                       Text="Muitos mouses vêm com “angle snapping”, “correção de ângulo” ou “straightening” ligado no software do fabricante (Logitech G Hub, Razer Synapse, etc). Ele “endireita” seus movimentos e atrapalha os microajustes. Abra o software do seu mouse e desligue. (O detector automático chega na v2.)"/>
                            <CheckBox x:Name="SnapCheck" Content="Já conferi e está desligado"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Raw Accel original" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                       Text="Se você usa a janela do Raw Accel original, deixe ela fechada: ao abrir, ela aplica as configurações dela por cima das do HarleAccel. Quer trazer a sua curva de lá? Use “Importar do Raw Accel” na tela Curva."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. Base -->
                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock Text="Sua sensibilidade de hoje" Style="{StaticResource H2}" FontSize="20"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,14"
                               Text="Coloque exatamente o que você usa hoje. Essa vai ser a base: nos movimentos lentos a sua mira continua igualzinha."/>
                    <Grid MaxWidth="620" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="JOGO PRINCIPAL" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="WGame" DisplayMemberPath="Name" SelectionChanged="Base_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SENS" Style="{StaticResource Label}"/>
                            <TextBox x:Name="WSens" TextChanged="Base_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="DPI" Style="{StaticResource Label}"/>
                            <TextBox x:Name="WDpi" TextChanged="Base_Changed"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WBaseResult" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 5. Ponto de partida -->
                <Grid x:Name="Step5" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ponto de partida" Style="{StaticResource H2}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                                   Text="Escolha por onde começar. Dá para ajustar tudo depois na tela Curva. Na v2, o Teste de Perfil vai recomendar a curva pelo seu jeito de jogar."/>
                        <RadioButton x:Name="PNone" Style="{StaticResource Pill}" Content="Sem aceleração (só configurar)" GroupName="preset" Margin="0,0,0,8" Checked="Preset_Checked"/>
                        <RadioButton x:Name="PSoft" Style="{StaticResource Pill}" Content="Suave: quase não muda, bom para começar" GroupName="preset" Margin="0,0,0,8" Checked="Preset_Checked" IsChecked="True"/>
                        <RadioButton x:Name="PMid" Style="{StaticResource Pill}" Content="Média: flicks bem mais fáceis" GroupName="preset" Margin="0,0,0,8" Checked="Preset_Checked"/>
                        <RadioButton x:Name="PStrong" Style="{StaticResource Pill}" Content="Forte: para quem já usa aceleração" GroupName="preset" Margin="0,0,0,8" Checked="Preset_Checked"/>
                        <TextBlock x:Name="PresetInfo" Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                    <c:CurveChart x:Name="PreviewChart" Grid.Column="2" MinHeight="260"/>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
