<UserControl x:Class="HarleAccel.Views.ProfileTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HarleAccel.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Teste de Perfil" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                       Text="Jogue normalmente por 2 ou 3 partidas (uns 20 a 30 minutos). O HarleAccel só LÊ o movimento do mouse, sem tocar no jogo, e no fim recomenda a curva para o seu jeito de jogar. A curva não muda no meio da partida."/>

            <!-- Gravação -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Gravação" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" LineHeight="20">
                        1. Clique em Começar e abra o seu jogo.
                        <LineBreak/>2. Jogue normal. Só conta o tempo em que o jogo está em foco e o cursor está escondido (menus e lobby não entram).
                        <LineBreak/>3. Quando a barra encher, volte aqui e clique em Terminar.
                    </TextBlock>
                    <CheckBox x:Name="NeutralBox" IsChecked="True" Margin="0,0,0,14"
                              Content="Desligar a minha curva durante o teste (recomendado: mede a sua mão sem aceleração)"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartBtn" Content="Começar" Style="{StaticResource Primary}" Click="Start_Click" Padding="22,10"/>
                        <Button x:Name="StopBtn" Content="Terminar e analisar" Click="Stop_Click" Margin="10,0,0,0" IsEnabled="False"/>
                        <Button x:Name="CancelBtn" Content="Cancelar" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="6,0,0,0" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel x:Name="LivePanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="GameDot" Width="10" Height="10" Fill="{StaticResource Warn}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="Progress" Height="8" Maximum="1" Foreground="{StaticResource Accent}"
                                     Background="{StaticResource Line}" BorderThickness="0"/>
                        <TextBlock x:Name="LiveText" Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Resultado -->
            <Border x:Name="ResultCard" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="ResultDate" DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Seu perfil" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Você é " FontSize="22" Foreground="{StaticResource Silver}"/>
                        <TextBlock x:Name="StyleText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                    </StackPanel>
                    <TextBlock x:Name="InsightsText" Style="{StaticResource Sub}" FontSize="13" Foreground="{StaticResource Silver}" LineHeight="21" Margin="0,0,0,14"/>

                    <c:CurveChart x:Name="Chart" Height="300"/>

                    <TextBlock Text="CURVA RECOMENDADA" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="RecTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WhyText" Style="{StaticResource Sub}" FontSize="13" LineHeight="21" Margin="0,6,0,14"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,12"
                               Text="É um ponto de partida calculado a partir do seu movimento. O teste A/B confirma se ela é melhor de verdade."/>

                    <WrapPanel>
                        <Button Content="Aplicar recomendada" Style="{StaticResource Primary}" Click="ApplyRec_Click" Margin="0,0,8,8"/>
                        <Button Content="Comparar no teste A/B" Click="AB_Click" Margin="0,0,8,8"/>
                        <Button Content="Abrir no editor" Click="Edit_Click" Margin="0,0,8,8"/>
                        <Button Content="Ver rotina de treino" Click="Train_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ResultStatus" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
