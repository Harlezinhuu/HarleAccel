<UserControl x:Class="HarleAccel.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Cabeçalho -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Limpar conversa" Style="{StaticResource Ghost}" Click="Clear_Click" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="Harle IA" Style="{StaticResource H1}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse x:Name="ModeDot" Width="8" Height="8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModeText" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Entrada -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel x:Name="Suggestions" Margin="0,0,0,8"/>
            <DockPanel>
                <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Enviar" Style="{StaticResource Primary}"
                        Click="Send_Click" Margin="8,0,0,0" Padding="20,10" VerticalAlignment="Bottom"/>
                <TextBox x:Name="Input" MaxLength="1500" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_KeyDown"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Sub}" FontSize="11" Margin="2,6,0,0"
                       Text="Enter envia · Shift+Enter quebra a linha · As contas são feitas pelo app, e a IA nunca aplica nada sem o seu clique."/>
        </StackPanel>

        <!-- Mensagens -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Messages" Margin="0,0,8,0"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
