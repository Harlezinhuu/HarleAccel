<UserControl x:Class="HarleAccel.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Créditos" Style="{StaticResource H1}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Criado por Harle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Sub}" Margin="0,4,0,4"/>
                    <TextBlock Text="© Harle. Todos os direitos reservados." Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button Content="Discord da comunidade" Style="{StaticResource Primary}" Margin="0,0,8,0"
                                Tag="https://discord.gg/rDb9raznQ7" Click="Link_Click"/>
                        <Button Content="GitHub do Harle" Tag="https://github.com/Harlezinhuu" Click="Link_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Raw Accel" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10"
                               Text="O HarleAccel usa o driver oficial e assinado do Raw Accel, baixado direto do GitHub oficial do projeto e conferido por SHA-256. A matemática das curvas no gráfico também foi portada do Raw Accel. Raw Accel não é afiliado ao HarleAccel."/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10"
                               Text="Créditos do Raw Accel: simon (driver e lógica de aceleração), _m00se_ (GUI, gain e tipos de aceleração), Sidiouth (testes) e colaboradores."/>
                    <Button Content="Raw Accel no GitHub" HorizontalAlignment="Left" Margin="0,0,0,12"
                            Tag="https://github.com/RawAccelOfficial/rawaccel" Click="Link_Click"/>
                    <TextBlock Text="LICENÇA DO RAW ACCEL (MIT)" Style="{StaticResource Label}"/>
                    <Border Background="{StaticResource Panel}" CornerRadius="0" Padding="12">
                        <TextBlock x:Name="LicenseText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Treinos" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}"
                               Text="As rotinas de treino usam cenários e playlists públicas das rotinas fundamentais do Voltaic (voltaic.gg), para Aim Lab e KovaaK's. Todo o crédito dos cenários e das playlists é dos criadores. Aim Lab e KovaaK's não são afiliados ao HarleAccel."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
