<UserControl x:Class="HarleAccel.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Treino de adaptação" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                       Text="Uma rotina de 30 a 40 minutos para a mão acostumar com a curva nova. O HarleAccel é o treinador: monta os blocos, cronometra e guarda a sua evolução. Os cenários você joga no Aim Lab (grátis) ou no KovaaK's."/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ONDE VOCÊ TREINA" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="PlatformBox" SelectionChanged="Selection_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NÍVEL" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LevelBox" SelectionChanged="Selection_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="FOCO" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="StyleBox" SelectionChanged="Selection_Changed"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StyleHint" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="RoutineMinutes" DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentHi}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RoutineTitle" Style="{StaticResource H2}" Margin="0"/>
                    </DockPanel>
                    <TextBlock x:Name="RoutineDesc" Style="{StaticResource Sub}" Margin="0,4,0,12"/>
                    <StackPanel x:Name="BlocksPanel"/>
                    <TextBlock x:Name="CreditText" Style="{StaticResource Sub}" FontSize="11" Margin="0,8,0,12"/>
                    <WrapPanel>
                        <Button x:Name="StartBtn" Content="Começar treino" Style="{StaticResource Primary}" Click="Start_Click" Margin="0,0,8,8" Padding="22,10"/>
                        <Button x:Name="CodeBtn" Content="Copiar código" Click="Code_Click" Margin="0,0,8,8"/>
                        <Button x:Name="LinkBtn" Content="Abrir playlist" Click="Link_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0"
                               Text="Dica: uma sessão já ajuda, mas memória muscular vem com repetição. Se ainda estranhar a curva, repita a rotina nos próximos dias. Jogue o aim trainer em modo janela sem borda para ver o cronômetro por cima."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Sua evolução" Style="{StaticResource H2}"/>
                    <StackPanel x:Name="EvolutionPanel"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
