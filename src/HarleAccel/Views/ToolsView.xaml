<UserControl x:Class="HarleAccel.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Diagnóstico do mouse" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                       Text="Ferramentas para descobrir o que o seu mouse faz de verdade. Durante as medições, a sua curva é desligada por alguns segundos e volta sozinha no final."/>

            <!-- DPI real -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Medidor de DPI real" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" LineHeight="20">
                        1. Coloque uma régua ou trena na mesa, ao lado do mouse.
                        <LineBreak/>2. Clique em Começar medição.
                        <LineBreak/>3. Segure o botão esquerdo, arraste o mouse exatamente a distância escolhida em linha reta e solte. São 3 tentativas.
                        <LineBreak/>Faça o arraste em cima do quadro cinza abaixo, para não clicar em nada sem querer.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="DISTÂNCIA" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="D5" Style="{StaticResource Pill}" Content="5 cm" GroupName="dist"/>
                        <RadioButton x:Name="D10" Style="{StaticResource Pill}" Content="10 cm" GroupName="dist" IsChecked="True"/>
                        <RadioButton x:Name="D20" Style="{StaticResource Pill}" Content="20 cm" GroupName="dist"/>
                    </StackPanel>
                    <Border Background="{StaticResource Panel}" CornerRadius="10" Height="110" Margin="0,0,0,12"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="DpiLive" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                                   Foreground="{StaticResource Muted}" Text="área de arraste" TextAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DpiStart" Content="Começar medição" Style="{StaticResource Primary}" Click="DpiStart_Click"/>
                        <Button x:Name="DpiUse" Content="Usar essa DPI" Click="DpiUse_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="DpiResult" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"/>
                </StackPanel>
            </Border>

            <!-- Angle snapping -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Detector de angle snapping" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                               Text="Angle snapping (ou “correção de ângulo”) é quando o sensor “endireita” os movimentos quase retos. Muita gente tem isso ligado no software do mouse sem saber, e ele atrapalha o microajuste. Clique em Começar e desenhe círculos grandes e devagar pela mesa por 15 segundos."/>
                    <Border Background="{StaticResource Panel}" CornerRadius="10" Height="220" Margin="0,0,0,12" ClipToBounds="True"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Canvas x:Name="SnapCanvas"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SnapStart" Content="Começar (15 s)" Style="{StaticResource Primary}" Click="SnapStart_Click"/>
                        <TextBlock x:Name="SnapLive" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <TextBlock x:Name="SnapResult" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
