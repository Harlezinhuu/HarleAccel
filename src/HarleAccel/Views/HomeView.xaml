<UserControl x:Class="HarleAccel.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Início" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Tudo o que importa sobre a sua aceleração, num lugar só."/>

            <UniformGrid Columns="2">
                <!-- Driver -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="DRIVER RAW ACCEL" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="DriverTitle" FontSize="18" FontWeight="Bold" Margin="0,2,0,4"/>
                        <TextBlock x:Name="DriverText" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                        <Button Content="Abrir assistente" HorizontalAlignment="Left" Click="Wizard_Click"/>
                    </StackPanel>
                </Border>

                <!-- Windows -->
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ACELERAÇÃO DO WINDOWS" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="EppTitle" FontSize="18" FontWeight="Bold" Margin="0,2,0,4"/>
                        <TextBlock x:Name="EppText" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                        <Button x:Name="EppBtn" Content="Desligar agora" HorizontalAlignment="Left" Click="Epp_Click"/>
                    </StackPanel>
                </Border>

                <!-- Base -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="SUA BASE" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="BaseTitle" FontSize="18" FontWeight="Bold" Margin="0,2,0,4"/>
                        <TextBlock x:Name="BaseText" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                        <Button Content="Calculadora de sensibilidade" HorizontalAlignment="Left" Click="Sens_Click"/>
                    </StackPanel>
                </Border>

                <!-- Curva -->
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CURVA EM USO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="CurveTitle" FontSize="18" FontWeight="Bold" Margin="0,2,0,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurveText" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                        <Button Content="Editar curva" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Curve_Click"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Próximos passos" Style="{StaticResource H2}"/>
                    <StackPanel x:Name="NextSteps"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
