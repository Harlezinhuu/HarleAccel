<UserControl x:Class="HarleAccel.Views.SensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Sensibilidade" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,20"
                       Text="Calcule seu cm/360, converta para outros jogos e defina a base da sua curva. A base é a sensibilidade que você já usa: o HarleAccel mantém ela igual nos movimentos lentos, então você não perde a memória muscular."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Entrada -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Sua configuração" Style="{StaticResource H2}"/>

                        <TextBlock Text="JOGO" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="GameBox" DisplayMemberPath="Name" SelectionChanged="Input_Changed" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SensLabel" Text="SENSIBILIDADE NO JOGO" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SensBox" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DPI DO MOUSE" Style="{StaticResource Label}"/>
                                <TextBox x:Name="DpiBox" TextChanged="Input_Changed"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,10,0,0"
                                   Text="Dica: a DPI anunciada nem sempre é a real. O medidor de DPI real chega na v2."/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="SaveBtn" Content="Salvar como minha base" Style="{StaticResource Primary}" Click="Save_Click"/>
                            <TextBlock x:Name="SaveStatus" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Resultado -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Resultado" Style="{StaticResource H2}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="cm/360" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="CmText" Style="{StaticResource BigNumber}" Text="—"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="eDPI" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="EdpiText" Style="{StaticResource BigNumber}" Text="—"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border CornerRadius="0" Background="{StaticResource Panel}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sensibilidade " Foreground="{StaticResource Muted}" FontSize="13"/>
                                    <TextBlock x:Name="ClassText" FontWeight="Bold" Foreground="{StaticResource AccentHi}" FontSize="13"/>
                                    <TextBlock Text=" para esse jogo" Foreground="{StaticResource Muted}" FontSize="13"/>
                                </StackPanel>
                                <TextBlock x:Name="ClassDetail" Style="{StaticResource Sub}" Margin="0,4,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="COM A SUA CURVA ATUAL" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="CurveInfo" Style="{StaticResource Sub}" FontSize="13" Foreground="{StaticResource Silver}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Conversor -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Converter para outros jogos" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                               Text="Mesmo cm/360 em todos os jogos, com a mesma DPI. Assim a sua mira fica igual em qualquer um."/>
                    <Grid x:Name="ConvertGrid"/>
                </StackPanel>
            </Border>

            <!-- cm/360 alvo -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Quero um cm/360 específico" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TargetCmBox" Width="120" TextChanged="Target_Changed"/>
                        <TextBlock Text="cm/360  →" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="TargetResult" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentHi}" Text="digite um valor"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
