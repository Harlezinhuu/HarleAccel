<UserControl x:Class="HarleAccel.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Histórico de curvas" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16"
                       Text="Toda curva que você aplica fica guardada aqui. Não gostou da nova? Volte para qualquer uma com um clique."/>
            <TextBlock x:Name="Status" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="List" Margin="0,0,8,0"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
