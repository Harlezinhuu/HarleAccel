<UserControl x:Class="HarleAccel.Views.SensFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Buscador de sens" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                       Text="Acha a sua sensibilidade pelo método PSA, às cegas. Em cada rodada você joga duas versões de 15 segundos, uma mais baixa e uma mais alta, sem saber qual é qual, e escolhe a melhor. O intervalo vai fechando pela metade até sobrar uma faixa de uns ±2%."/>

            <!-- Começar -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Ponto de partida" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="BaseText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14" LineHeight="20">
                        • São 5 rodadas, uns 3 minutos no total. O app muda a sens pelo driver só durante o teste e devolve tudo no final.
                        <LineBreak/>• Escolha pela sensação: qual foi mais confortável e precisa. Os números aparecem depois de cada escolha.
                        <LineBreak/>• O teste é na tela do Windows, não dentro do jogo. Use o resultado como ponto de partida e confirme jogando.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartBtn" Content="Começar" Style="{StaticResource Primary}" Click="Start_Click" Padding="22,10"/>
                        <Button x:Name="CancelBtn" Content="Cancelar" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Rodada -->
            <Border x:Name="RoundCard" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="RoundRange" DockPanel.Dock="Right" FontFamily="{DynamicResource DataFont}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RoundTitle" Style="{StaticResource H2}" Margin="0"/>
                    </DockPanel>
                    <ProgressBar x:Name="RoundProgress" Height="4" Maximum="5" Margin="0,10,0,14"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>

                    <StackPanel x:Name="ChoicePanel" Visibility="Collapsed">
                        <TextBlock Text="Qual foi melhor?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Versão ①" Click="Pick1_Click" Margin="0,0,8,8" Padding="22,10"/>
                            <Button Content="Versão ②" Click="Pick2_Click" Margin="0,0,8,8" Padding="22,10"/>
                            <Button Content="Iguais" Style="{StaticResource Ghost}" Click="Pick0_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="RevealPanel" Visibility="Collapsed">
                        <TextBlock x:Name="RevealText" FontSize="13" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Silver}"/>
                        <Button x:Name="NextBtn" Content="Próxima rodada" Style="{StaticResource Primary}" Click="Next_Click"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Resultado -->
            <Border x:Name="ResultCard" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Sua sens" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ResultBig" Style="{StaticResource BigNumber}"/>
                    <TextBlock x:Name="ResultText" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,10" Foreground="{StaticResource Silver}"/>
                    <Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,0,12" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DIAGNÓSTICO DAS ÚLTIMAS RODADAS" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ResultDiag" FontSize="13" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Silver}"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <Button x:Name="UseBtn" Content="Usar como minha sens base" Style="{StaticResource Primary}" Click="Use_Click" Margin="0,0,8,8"/>
                        <Button Content="Ver em todos os jogos" Click="Converter_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="UseStatus" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
