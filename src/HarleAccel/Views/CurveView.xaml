<UserControl x:Class="HarleAccel.Views.CurveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HarleAccel.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Esquerda: gráfico + explicação ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Curva" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,14"
                           Text="Passe o mouse no gráfico para ver o que a curva faz em cada velocidade. Em 1x a sua sens fica exatamente a do jogo."/>
            </StackPanel>

            <c:CurveChart x:Name="Chart" Grid.Row="1" MinHeight="300"/>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Curva explicada" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ExplainText" Style="{StaticResource Sub}" FontSize="13" Foreground="{StaticResource Silver}" LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Direita: controles ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <!-- Eixo -->
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="EDITANDO" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AxisX" Style="{StaticResource Pill}" Content="Horizontal" GroupName="axis" IsChecked="True" Checked="Axis_Checked"/>
                            <RadioButton x:Name="AxisY" Style="{StaticResource Pill}" Content="Vertical" GroupName="axis" Checked="Axis_Checked"/>
                        </StackPanel>
                        <TextBlock x:Name="AxisHint" Style="{StaticResource Sub}" FontSize="11" Margin="0,6,0,0"
                                   Text="Ligue “Vertical com curva própria” lá embaixo para editar o vertical separado."/>
                    </StackPanel>
                </Border>

                <!-- Estilos prontos -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTILOS PRONTOS" Style="{StaticResource Label}"/>
                        <WrapPanel>
                            <Button Content="Flicker" Click="Preset_Click" Tag="Flicker" Margin="0,0,6,6" Padding="12,7"/>
                            <Button Content="Tracker" Click="Preset_Click" Tag="Tracker" Margin="0,0,6,6" Padding="12,7"/>
                            <Button Content="Híbrido" Click="Preset_Click" Tag="Híbrido" Margin="0,0,6,6" Padding="12,7"/>
                            <Button x:Name="RecBtn" Content="Recomendada (Teste de Perfil)" Click="Preset_Click" Tag="rec" Margin="0,0,6,6" Padding="12,7"/>
                        </WrapPanel>
                        <TextBlock x:Name="PresetHint" Style="{StaticResource Sub}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Estilo -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTILO DA CURVA" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="StyleBox" SelectionChanged="Style_Changed">
                            <ComboBoxItem Content="Sem aceleração"/>
                            <ComboBoxItem Content="Linear"/>
                            <ComboBoxItem Content="Natural (suave, com limite)"/>
                            <ComboBoxItem Content="Personalizada (pontos)"/>
                        </ComboBox>
                        <TextBlock x:Name="StyleHint" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,0"/>

                        <!-- Linear / Natural -->
                        <StackPanel x:Name="ParamPanel" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock x:Name="StartVal" DockPanel.Dock="Right" Foreground="{StaticResource AccentHi}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="COMEÇA A ACELERAR EM" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <Slider x:Name="StartSlider" Minimum="0" Maximum="40" SmallChange="0.5" ValueChanged="Param_Changed" Margin="0,0,0,12"/>

                            <DockPanel>
                                <TextBlock x:Name="RateVal" DockPanel.Dock="Right" Foreground="{StaticResource AccentHi}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="RateLabel" Text="FORÇA" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <Slider x:Name="RateSlider" Minimum="0" Maximum="100" ValueChanged="Param_Changed" Margin="0,0,0,12"/>

                            <DockPanel>
                                <TextBlock x:Name="MaxVal" DockPanel.Dock="Right" Foreground="{StaticResource AccentHi}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="SENS MÁXIMA" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <Slider x:Name="MaxSlider" Minimum="1.05" Maximum="4" SmallChange="0.05" ValueChanged="Param_Changed"/>
                        </StackPanel>

                        <!-- Personalizada -->
                        <StackPanel x:Name="PointsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="PONTOS (velocidade cm/s : multiplicador)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="PointsBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                            <TextBlock x:Name="PointsError" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Atualizar gráfico" Click="Points_Apply" Margin="0,0,8,8"/>
                                <Button Content="Copiar curva anterior" Click="Points_FromCurve" Margin="0,0,8,8"
                                        ToolTip="Transforma a última curva Linear/Natural em pontos para você ajustar à mão"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Splitter X/Y -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Splitter X/Y" Style="{StaticResource H2}"/>
                        <DockPanel>
                            <TextBlock x:Name="RatioVal" DockPanel.Dock="Right" Foreground="{StaticResource AccentHi}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="SENS VERTICAL" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Slider x:Name="RatioSlider" Minimum="0.5" Maximum="1.5" SmallChange="0.01" ValueChanged="Ratio_Changed"/>
                        <TextBlock x:Name="RatioHint" Style="{StaticResource Sub}" FontSize="12" Margin="0,4,0,10"/>
                        <CheckBox x:Name="SeparateBox" Content="Vertical com curva própria" Checked="Separate_Changed" Unchecked="Separate_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Avançado -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Avançado" Style="{StaticResource H2}"/>
                        <DockPanel>
                            <TextBlock x:Name="RotVal" DockPanel.Dock="Right" Foreground="{StaticResource AccentHi}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="ROTAÇÃO" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Slider x:Name="RotSlider" Minimum="-15" Maximum="15" SmallChange="0.5" ValueChanged="Adv_Changed"/>
                        <TextBlock Style="{StaticResource Sub}" FontSize="11" Margin="0,2,0,12"
                                   Text="Corrige a mão que move o mouse levemente “torto”. O Teste de Perfil mede e sugere o valor."/>
                        <DockPanel>
                            <TextBlock x:Name="SnapVal" DockPanel.Dock="Right" Foreground="{StaticResource AccentHi}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="ANGLE SNAPPING DO DRIVER" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Slider x:Name="SnapSlider" Minimum="0" Maximum="45" SmallChange="1" ValueChanged="Adv_Changed"/>
                        <TextBlock x:Name="SnapWarn" Style="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"
                                   Text="Deixe em 0 para jogar. Ele “endireita” movimentos e piora o microajuste; só faz sentido para desenhar ou trabalhar no desktop."/>
                    </StackPanel>
                </Border>

                <!-- Ações -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <Button x:Name="ApplyBtn" Content="Aplicar no driver" Style="{StaticResource Primary}" Click="Apply_Click" Padding="16,12"/>
                        <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Content="Importar do Raw Accel" Click="Import_Click" Margin="0,0,4,8" Padding="8,9"/>
                            <Button Content="Exportar p/ Raw Accel" Click="Export_Click" Margin="4,0,0,8" Padding="8,9"/>
                        </UniformGrid>
                        <Button Content="Desativar aceleração (voltar ao normal)" Style="{StaticResource Ghost}" Click="Disable_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
