<UserControl x:Class="HarleAccel.Views.AimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Aim Test" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18"
                       Text="Prove com números se uma curva é melhor. Os alvos aparecem perto (microajuste) e longe (flick). Deixe o “Aumentar precisão do ponteiro” desligado para o teste valer."/>

            <!-- A/B -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Teste cego A/B" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                               Text="São 4 rodadas de 30 segundos, alternando duas curvas sem dizer qual é qual. No fim você escolhe a que pareceu melhor, e só aí o app revela qual era cada uma e mostra os números. Isso tira o placebo da jogada."/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CURVA A (atual)" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="AText" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CURVA B" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="BSource" SelectionChanged="BSource_Changed">
                                <ComboBoxItem Content="Recomendada pelo Teste de Perfil"/>
                                <ComboBoxItem Content="A curva do editor"/>
                                <ComboBoxItem Content="Sem aceleração"/>
                            </ComboBox>
                            <TextBlock x:Name="BText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ABStart" Content="Começar teste A/B" Style="{StaticResource Primary}" Click="ABStart_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="ChoicePanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock Text="Qual pareceu melhor?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Curva ①" Click="Choose1_Click" Margin="0,0,8,0" Padding="22,10"/>
                            <Button Content="Curva ②" Click="Choose2_Click" Margin="0,0,8,0" Padding="22,10"/>
                            <Button Content="Tanto faz" Style="{StaticResource Ghost}" Click="Choose0_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="RevealPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RevealText" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="KeepA" Content="Ficar com a A" Click="KeepA_Click" Margin="0,0,8,0"/>
                            <Button x:Name="KeepB" Content="Ficar com a B" Style="{StaticResource Primary}" Click="KeepB_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock x:Name="ABStatus" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Antes e depois -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Antes e depois" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                               Text="Faça um aim test de 45 segundos com a curva atual. Repita depois de trocar de curva (e depois de uns dias de treino) para ver se você melhorou de verdade."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SingleBtn" Content="Fazer aim test (45 s)" Style="{StaticResource Primary}" Click="Single_Click"/>
                        <TextBlock x:Name="SingleStatus" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="CompareText" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,10" LineHeight="22"/>
                    <StackPanel x:Name="ResultsList"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
